rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Global Hardened Primitives
    // -------------------------------------------------------------------------
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 2 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdminEmail() {
      return isVerifiedUser() && (
        request.auth.token.email == 'ezeprodeveloper@gmail.com' ||
        request.auth.token.email == 'hbmgshzchl@gmail.com'
      );
    }

    function isAdmin() {
      return isAdminEmail() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isShortString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isNonNegNumber(val) {
      return val is number && val >= 0 && val <= 1000000000;
    }

    // -------------------------------------------------------------------------
    // Entity Validation Blueprints (No existing() or diff() inside helpers)
    // -------------------------------------------------------------------------
    function isValidSettings(data) {
      return data.keys().hasAll([
        'activationFeeRwf', 'welcomeBonusRwf', 'dailyCheckInRwf',
        'withdrawalFeePercent', 'subsequentMinWithdrawalRwf', 'subsequentMaxWithdrawalRwf',
        'referralCommissionPercent', 'minVideoRewardRwf', 'momoPayCode',
        'platformTagline', 'maintenanceMode'
      ]) && data.keys().hasOnly([
        'activationFeeRwf', 'welcomeBonusRwf', 'dailyCheckInRwf',
        'withdrawalFeePercent', 'subsequentMinWithdrawalRwf', 'subsequentMaxWithdrawalRwf',
        'referralCommissionPercent', 'minVideoRewardRwf', 'momoPayCode',
        'platformTagline', 'maintenanceMode', 'updatedAt'
      ]) &&
      isNonNegNumber(data.activationFeeRwf) &&
      isNonNegNumber(data.welcomeBonusRwf) &&
      isNonNegNumber(data.dailyCheckInRwf) &&
      isNonNegNumber(data.withdrawalFeePercent) && data.withdrawalFeePercent <= 90 &&
      isNonNegNumber(data.subsequentMinWithdrawalRwf) &&
      isNonNegNumber(data.subsequentMaxWithdrawalRwf) &&
      isNonNegNumber(data.referralCommissionPercent) && data.referralCommissionPercent <= 50 &&
      isNonNegNumber(data.minVideoRewardRwf) &&
      isShortString(data.momoPayCode, 3, 32) &&
      isShortString(data.platformTagline, 5, 300) &&
      data.maintenanceMode is bool &&
      (!('updatedAt' in data) || isShortString(data.updatedAt, 10, 64));
    }

    function isValidPromotion(data) {
      return data.keys().hasAll(['id', 'title', 'summary', 'category', 'active', 'createdAt']) &&
        data.keys().hasOnly(['id', 'title', 'summary', 'category', 'active', 'createdAt']) &&
        isValidId(data.id) &&
        isShortString(data.title, 2, 180) &&
        isShortString(data.summary, 5, 1500) &&
        isShortString(data.category, 2, 80) &&
        data.active is bool &&
        isShortString(data.createdAt, 10, 64);
    }

    function isValidUserPayload(data) {
      return data.keys().hasAll([
        'id', 'firstName', 'secondName', 'email', 'phone', 'gender',
        'dateOfBirth', 'idNumber', 'photoDataUrl', 'education', 'residence',
        'accountNumber', 'referralCode', 'spinCredits', 'hasCompletedFirstWithdrawal',
        'accountStatus', 'walletBalanceRwf', 'bonusBalanceRwf', 'savingsBalanceRwf',
        'checkInStreak', 'kycStatus', 'createdAt'
      ]) && data.keys().hasOnly([
        'id', 'firstName', 'secondName', 'email', 'phone', 'gender',
        'dateOfBirth', 'idNumber', 'photoDataUrl', 'education', 'residence',
        'passwordHash', 'accountNumber', 'referralCode', 'referredByUserId',
        'spinCredits', 'hasCompletedFirstWithdrawal', 'accountStatus',
        'activationPaymentRef', 'activationPaidPhone', 'walletBalanceRwf',
        'bonusBalanceRwf', 'savingsBalanceRwf', 'lastCheckInAt',
        'checkInStreak', 'kycStatus', 'kycData', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.id) &&
      isShortString(data.firstName, 1, 80) &&
      isShortString(data.secondName, 1, 80) &&
      isShortString(data.email, 5, 160) &&
      isShortString(data.phone, 9, 24) &&
      data.gender in ['Male', 'Female', 'Other'] &&
      isShortString(data.dateOfBirth, 8, 32) &&
      data.idNumber is string && data.idNumber.matches('^\\d{16}$') &&
      isShortString(data.photoDataUrl, 10, 450000) &&
      data.education is map &&
      data.residence is map &&
      (!('passwordHash' in data) || isShortString(data.passwordHash, 1, 128)) &&
      isShortString(data.accountNumber, 5, 32) &&
      isShortString(data.referralCode, 3, 32) &&
      (!('referredByUserId' in data) || isValidId(data.referredByUserId)) &&
      isNonNegNumber(data.spinCredits) &&
      data.hasCompletedFirstWithdrawal is bool &&
      data.accountStatus in ['pending_approval', 'awaiting_payment', 'payment_submitted', 'active', 'suspended'] &&
      (!('activationPaymentRef' in data) || isShortString(data.activationPaymentRef, 2, 120)) &&
      (!('activationPaidPhone' in data) || isShortString(data.activationPaidPhone, 8, 24)) &&
      isNonNegNumber(data.walletBalanceRwf) &&
      isNonNegNumber(data.bonusBalanceRwf) &&
      isNonNegNumber(data.savingsBalanceRwf) &&
      (!('lastCheckInAt' in data) || data.lastCheckInAt == null || isShortString(data.lastCheckInAt, 10, 64)) &&
      isNonNegNumber(data.checkInStreak) &&
      data.kycStatus in ['not_submitted', 'pending', 'approved', 'rejected'] &&
      (!('kycData' in data) || data.kycData is map) &&
      isShortString(data.createdAt, 10, 64) &&
      (!('updatedAt' in data) || isShortString(data.updatedAt, 10, 64));
    }

    function isValidUserCreate(data, userId) {
      return isValidUserPayload(data) &&
        data.id == userId &&
        data.accountStatus == 'pending_approval' &&
        data.kycStatus == 'not_submitted' &&
        data.walletBalanceRwf == 0 &&
        data.bonusBalanceRwf == 0 &&
        data.savingsBalanceRwf == 0 &&
        data.spinCredits == 0 &&
        data.checkInStreak == 0 &&
        data.hasCompletedFirstWithdrawal == false;
    }

    function isValidSavingsGoal(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'planType', 'targetRwf', 'currentRwf', 'targetDate', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'title', 'planType', 'targetRwf', 'currentRwf', 'targetDate', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.userId) &&
        isShortString(data.title, 1, 140) &&
        data.planType in ['Flexible', 'Goal-Based', 'Long-Term'] &&
        isNonNegNumber(data.targetRwf) && data.targetRwf >= 100 &&
        isNonNegNumber(data.currentRwf) &&
        isShortString(data.targetDate, 8, 32) &&
        isShortString(data.createdAt, 10, 64) &&
        (!('updatedAt' in data) || isShortString(data.updatedAt, 10, 64));
    }

    function isValidLoan(data) {
      return data.keys().hasAll([
        'id', 'userId', 'userName', 'product', 'reason', 'principalRwf',
        'termMonths', 'annualRatePercent', 'monthlyPaymentRwf', 'totalRepayableRwf',
        'repaidRwf', 'status', 'createdAt'
      ]) && data.keys().hasOnly([
        'id', 'userId', 'userName', 'product', 'reason', 'principalRwf',
        'termMonths', 'annualRatePercent', 'monthlyPaymentRwf', 'totalRepayableRwf',
        'repaidRwf', 'status', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.id) &&
      isValidId(data.userId) &&
      isShortString(data.userName, 1, 160) &&
      isShortString(data.product, 2, 120) &&
      isShortString(data.reason, 2, 300) &&
      isNonNegNumber(data.principalRwf) && data.principalRwf >= 500 &&
      data.termMonths is number && data.termMonths >= 1 && data.termMonths <= 36 &&
      isNonNegNumber(data.annualRatePercent) &&
      isNonNegNumber(data.monthlyPaymentRwf) &&
      isNonNegNumber(data.totalRepayableRwf) &&
      isNonNegNumber(data.repaidRwf) &&
      data.status in ['pending_admin', 'approved', 'repaid', 'rejected'] &&
      isShortString(data.createdAt, 10, 64) &&
      (!('updatedAt' in data) || isShortString(data.updatedAt, 10, 64));
    }

    function isValidInvestment(data) {
      return data.keys().hasAll([
        'id', 'userId', 'userName', 'tierId', 'planName', 'depositRwf',
        'dailyReturnRwf', 'paymentCode', 'paymentRef', 'status', 'totalEarnedRwf', 'createdAt'
      ]) && data.keys().hasOnly([
        'id', 'userId', 'userName', 'tierId', 'planName', 'depositRwf',
        'dailyReturnRwf', 'paymentCode', 'paymentRef', 'status', 'totalEarnedRwf',
        'lastRoiCreditedAt', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.id) &&
      isValidId(data.userId) &&
      isShortString(data.userName, 1, 160) &&
      isShortString(data.tierId, 2, 48) &&
      isShortString(data.planName, 2, 80) &&
      isNonNegNumber(data.depositRwf) && data.depositRwf >= 500 &&
      isNonNegNumber(data.dailyReturnRwf) &&
      isShortString(data.paymentCode, 3, 80) &&
      isShortString(data.paymentRef, 3, 120) &&
      data.status in ['pending_admin', 'active', 'completed', 'rejected'] &&
      isNonNegNumber(data.totalEarnedRwf) &&
      (!('lastRoiCreditedAt' in data) || data.lastRoiCreditedAt == null || isShortString(data.lastRoiCreditedAt, 10, 64)) &&
      isShortString(data.createdAt, 10, 64) &&
      (!('updatedAt' in data) || isShortString(data.updatedAt, 10, 64));
    }

    function isValidSpin(data) {
      return data.keys().hasAll(['id', 'userId', 'rewardRwf', 'spunAt']) &&
        data.keys().hasOnly(['id', 'userId', 'rewardRwf', 'spunAt']) &&
        isValidId(data.id) &&
        isValidId(data.userId) &&
        isNonNegNumber(data.rewardRwf) && data.rewardRwf <= 200 &&
        isShortString(data.spunAt, 10, 64);
    }

    function isValidWithdrawal(data) {
      return data.keys().hasAll([
        'id', 'userId', 'userName', 'network', 'destinationType', 'destinationValue',
        'accountRegisteredNames', 'grossAmountRwf', 'feePercent', 'feeRwf',
        'netAmountRwf', 'isFirstBonusWithdrawal', 'status', 'createdAt'
      ]) && data.keys().hasOnly([
        'id', 'userId', 'userName', 'network', 'destinationType', 'destinationValue',
        'accountRegisteredNames', 'grossAmountRwf', 'feePercent', 'feeRwf',
        'netAmountRwf', 'isFirstBonusWithdrawal', 'status', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.id) &&
      isValidId(data.userId) &&
      isShortString(data.userName, 1, 160) &&
      data.network in ['MTN Rwanda', 'Airtel / Tigo Rwanda'] &&
      data.destinationType in ['Phone Number', 'MoMo Pay Code'] &&
      isShortString(data.destinationValue, 3, 64) &&
      isShortString(data.accountRegisteredNames, 2, 160) &&
      isNonNegNumber(data.grossAmountRwf) &&
      isNonNegNumber(data.feePercent) &&
      isNonNegNumber(data.feeRwf) &&
      isNonNegNumber(data.netAmountRwf) &&
      data.isFirstBonusWithdrawal is bool &&
      data.status in ['pending_admin', 'paid', 'rejected'] &&
      isShortString(data.createdAt, 10, 64) &&
      (!('updatedAt' in data) || isShortString(data.updatedAt, 10, 64));
    }

    function isValidVideoCampaign(data) {
      return data.keys().hasAll([
        'id', 'creatorId', 'creatorName', 'title', 'description', 'videoUrl',
        'rewardPerViewRwf', 'targetViewers', 'totalBudgetRwf', 'paymentCode',
        'paymentRef', 'watchedByUserIds', 'status', 'createdAt'
      ]) && data.keys().hasOnly([
        'id', 'creatorId', 'creatorName', 'title', 'description', 'videoUrl',
        'rewardPerViewRwf', 'targetViewers', 'totalBudgetRwf', 'paymentCode',
        'paymentRef', 'watchedByUserIds', 'status', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.id) &&
      isValidId(data.creatorId) &&
      isShortString(data.creatorName, 1, 160) &&
      isShortString(data.title, 2, 160) &&
      data.description is string && data.description.size() <= 1000 &&
      isShortString(data.videoUrl, 5, 500000) &&
      isNonNegNumber(data.rewardPerViewRwf) && data.rewardPerViewRwf >= 50 &&
      data.targetViewers is number && data.targetViewers >= 1 && data.targetViewers <= 5000 &&
      isNonNegNumber(data.totalBudgetRwf) &&
      isShortString(data.paymentCode, 3, 80) &&
      isShortString(data.paymentRef, 3, 120) &&
      data.watchedByUserIds is list && data.watchedByUserIds.size() <= 5000 &&
      (data.watchedByUserIds.size() == 0 || data.watchedByUserIds[0] is string) &&
      data.status in ['pending_admin', 'active', 'completed', 'rejected'] &&
      isShortString(data.createdAt, 10, 64) &&
      (!('updatedAt' in data) || isShortString(data.updatedAt, 10, 64));
    }

    function isValidCustomTask(data) {
      return data.keys().hasAll([
        'id', 'creatorId', 'creatorName', 'title', 'requirements',
        'rewardPerCompletionRwf', 'targetCompletions', 'totalBudgetRwf',
        'paymentCode', 'paymentRef', 'approvedWorkerIds', 'status', 'createdAt'
      ]) && data.keys().hasOnly([
        'id', 'creatorId', 'creatorName', 'title', 'requirements',
        'rewardPerCompletionRwf', 'targetCompletions', 'totalBudgetRwf',
        'paymentCode', 'paymentRef', 'approvedWorkerIds', 'status', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.id) &&
      isValidId(data.creatorId) &&
      isShortString(data.creatorName, 1, 160) &&
      isShortString(data.title, 2, 160) &&
      isShortString(data.requirements, 3, 2000) &&
      isNonNegNumber(data.rewardPerCompletionRwf) && data.rewardPerCompletionRwf >= 10 &&
      data.targetCompletions is number && data.targetCompletions >= 1 && data.targetCompletions <= 5000 &&
      isNonNegNumber(data.totalBudgetRwf) &&
      isShortString(data.paymentCode, 3, 80) &&
      isShortString(data.paymentRef, 3, 120) &&
      data.approvedWorkerIds is list && data.approvedWorkerIds.size() <= 5000 &&
      (data.approvedWorkerIds.size() == 0 || data.approvedWorkerIds[0] is string) &&
      data.status in ['pending_admin', 'active', 'completed', 'rejected'] &&
      isShortString(data.createdAt, 10, 64) &&
      (!('updatedAt' in data) || isShortString(data.updatedAt, 10, 64));
    }

    function isValidTaskSubmission(data) {
      return data.keys().hasAll([
        'id', 'taskId', 'taskTitle', 'workerId', 'workerName',
        'proofText', 'rewardRwf', 'status', 'submittedAt'
      ]) && data.keys().hasOnly([
        'id', 'taskId', 'taskTitle', 'workerId', 'workerName',
        'proofText', 'proofUrl', 'rewardRwf', 'status', 'adminNote', 'submittedAt', 'reviewedAt'
      ]) &&
      isValidId(data.id) &&
      isValidId(data.taskId) &&
      isShortString(data.taskTitle, 2, 160) &&
      isValidId(data.workerId) &&
      isShortString(data.workerName, 1, 160) &&
      isShortString(data.proofText, 2, 2000) &&
      (!('proofUrl' in data) || data.proofUrl == null || isShortString(data.proofUrl, 4, 500)) &&
      isNonNegNumber(data.rewardRwf) &&
      data.status in ['pending_admin', 'approved', 'rejected'] &&
      (!('adminNote' in data) || data.adminNote == null || isShortString(data.adminNote, 1, 300)) &&
      isShortString(data.submittedAt, 10, 64) &&
      (!('reviewedAt' in data) || data.reviewedAt == null || isShortString(data.reviewedAt, 10, 64));
    }

    function isValidTransaction(data) {
      return data.keys().hasAll([
        'id', 'userId', 'reference', 'title', 'category', 'channel',
        'amountRwf', 'direction', 'status', 'timestamp'
      ]) && data.keys().hasOnly([
        'id', 'userId', 'reference', 'title', 'category', 'channel',
        'amountRwf', 'feeRwf', 'direction', 'status', 'timestamp'
      ]) &&
      isValidId(data.id) &&
      isValidId(data.userId) &&
      isShortString(data.reference, 3, 48) &&
      isShortString(data.title, 2, 200) &&
      isShortString(data.category, 2, 48) &&
      isShortString(data.channel, 2, 200) &&
      isNonNegNumber(data.amountRwf) &&
      (!('feeRwf' in data) || isNonNegNumber(data.feeRwf)) &&
      data.direction in ['credit', 'debit'] &&
      data.status in ['Completed', 'Pending Review', 'Rejected'] &&
      isShortString(data.timestamp, 10, 64);
    }

    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------
    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (request.auth.uid == adminId || isAdminEmail());
      allow list, write: if false;
    }

    match /settings/{settingId} {
      allow get: if isValidId(settingId) && (settingId == 'platform' || isAdmin());
      allow list: if isAdminEmail();
      allow create: if isAdmin() && isValidId(settingId) && isValidSettings(incoming());
      allow update: if isAdmin() && isValidId(settingId) && isValidSettings(incoming());
      allow delete: if false;
    }

    match /promotions/{promoId} {
      allow get: if isValidId(promoId) && (existing().active == true || isAdmin());
      allow list: if existing().active == true || isAdminEmail();
      allow create: if isAdmin() && isValidId(promoId) && isValidPromotion(incoming());
      allow update: if isAdmin() && isValidId(promoId) && isValidPromotion(incoming()) && incoming().id == existing().id;
      allow delete: if isAdmin() && isValidId(promoId);
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && (existing().id == request.auth.uid || isAdminEmail());
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && isValidUserCreate(incoming(), userId);
      allow update: if isSignedIn() && isValidId(userId) && isValidUserPayload(incoming()) &&
        incoming().id == existing().id && incoming().createdAt == existing().createdAt && (
          isAdmin() || (
            request.auth.uid == userId &&
            incoming().photoDataUrl == existing().photoDataUrl &&
            incoming().accountNumber == existing().accountNumber &&
            incoming().referralCode == existing().referralCode && (
              // Action 1: Submit activation payment proof
              (existing().accountStatus == 'awaiting_payment' &&
               incoming().accountStatus == 'payment_submitted' &&
               incoming().diff(existing()).affectedKeys().hasOnly(['accountStatus', 'activationPaidPhone', 'activationPaymentRef', 'updatedAt'])) ||
              // Action 2: Submit Rwanda KYC for review
              (incoming().kycStatus == 'pending' &&
               incoming().diff(existing()).affectedKeys().hasOnly(['kycStatus', 'kycData', 'updatedAt'])) ||
              // Action 3: Daily check-in claim (capped delta)
              (existing().accountStatus == 'active' &&
               incoming().checkInStreak == existing().checkInStreak + 1 &&
               incoming().walletBalanceRwf >= existing().walletBalanceRwf &&
               incoming().walletBalanceRwf <= existing().walletBalanceRwf + 500 &&
               incoming().diff(existing()).affectedKeys().hasOnly(['walletBalanceRwf', 'lastCheckInAt', 'checkInStreak', 'updatedAt'])) ||
              // Action 4: Savings deposit or retrieval (net sum preserved)
              (existing().accountStatus == 'active' && existing().kycStatus == 'approved' &&
               incoming().walletBalanceRwf + incoming().savingsBalanceRwf == existing().walletBalanceRwf + existing().savingsBalanceRwf &&
               incoming().diff(existing()).affectedKeys().hasOnly(['walletBalanceRwf', 'savingsBalanceRwf', 'updatedAt'])) ||
              // Action 5: Lucky Spin completion (consumes 1 spin credit, <= 200 RWF win)
              (existing().accountStatus == 'active' && existing().spinCredits >= 1 &&
               incoming().spinCredits == existing().spinCredits - 1 &&
               incoming().walletBalanceRwf >= existing().walletBalanceRwf &&
               incoming().walletBalanceRwf <= existing().walletBalanceRwf + 200 &&
               incoming().diff(existing()).affectedKeys().hasOnly(['spinCredits', 'walletBalanceRwf', 'updatedAt'])) ||
              // Action 6: Watch short video reward (bounded)
              (existing().accountStatus == 'active' &&
               incoming().walletBalanceRwf > existing().walletBalanceRwf &&
               incoming().walletBalanceRwf <= existing().walletBalanceRwf + 5000 &&
               incoming().diff(existing()).affectedKeys().hasOnly(['walletBalanceRwf', 'updatedAt'])) ||
              // Action 7: Withdrawal debit hold or loan wallet repayment (debit only)
              (existing().accountStatus == 'active' &&
               incoming().walletBalanceRwf < existing().walletBalanceRwf &&
               incoming().walletBalanceRwf >= 0 &&
               incoming().diff(existing()).affectedKeys().hasOnly(['walletBalanceRwf', 'updatedAt'])) ||
              // Action 8: Education or residence self-update
              (incoming().diff(existing()).affectedKeys().hasOnly(['education', 'residence', 'updatedAt']))
            )
          )
        );
      allow delete: if isAdmin() && isValidId(userId);
    }

    match /savingsGoals/{goalId} {
      allow get: if isSignedIn() && isValidId(goalId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isAdminEmail());
      allow create: if isSignedIn() && isValidId(goalId) && isValidSavingsGoal(incoming()) &&
        incoming().userId == request.auth.uid && incoming().currentRwf == 0;
      allow update: if isSignedIn() && isValidId(goalId) && isValidSavingsGoal(incoming()) &&
        incoming().id == existing().id && incoming().userId == existing().userId && (
          isAdmin() ||
          (existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['currentRwf', 'updatedAt']))
        );
      allow delete: if isAdmin() && isValidId(goalId);
    }

    match /loans/{loanId} {
      allow get: if isSignedIn() && isValidId(loanId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isAdminEmail());
      allow create: if isSignedIn() && isValidId(loanId) && isValidLoan(incoming()) &&
        incoming().userId == request.auth.uid && incoming().status == 'pending_admin' && incoming().repaidRwf == 0;
      allow update: if isSignedIn() && isValidId(loanId) && isValidLoan(incoming()) &&
        incoming().id == existing().id && incoming().userId == existing().userId && (
          isAdmin() ||
          (existing().userId == request.auth.uid &&
           existing().status == 'approved' &&
           incoming().repaidRwf > existing().repaidRwf &&
           incoming().status in ['approved', 'repaid'] &&
           incoming().diff(existing()).affectedKeys().hasOnly(['repaidRwf', 'status', 'updatedAt']))
        );
      allow delete: if isAdmin() && isValidId(loanId);
    }

    match /investments/{investmentId} {
      allow get: if isSignedIn() && isValidId(investmentId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isAdminEmail());
      allow create: if isSignedIn() && isValidId(investmentId) && isValidInvestment(incoming()) &&
        incoming().userId == request.auth.uid && incoming().status == 'pending_admin' && incoming().totalEarnedRwf == 0;
      allow update: if isSignedIn() && isValidId(investmentId) && isValidInvestment(incoming()) &&
        incoming().id == existing().id && incoming().userId == existing().userId && (
          isAdmin() ||
          (existing().userId == request.auth.uid &&
           existing().status == 'active' &&
           incoming().totalEarnedRwf >= existing().totalEarnedRwf &&
           incoming().status in ['active', 'completed'] &&
           incoming().diff(existing()).affectedKeys().hasOnly(['totalEarnedRwf', 'lastRoiCreditedAt', 'status', 'updatedAt']))
        );
      allow delete: if isAdmin() && isValidId(investmentId);
    }

    match /spinHistory/{spinId} {
      allow get: if isSignedIn() && isValidId(spinId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isAdminEmail());
      allow create: if isSignedIn() && isValidId(spinId) && isValidSpin(incoming()) && incoming().userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /withdrawals/{withdrawalId} {
      allow get: if isSignedIn() && isValidId(withdrawalId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isAdminEmail());
      allow create: if isSignedIn() && isValidId(withdrawalId) && isValidWithdrawal(incoming()) &&
        incoming().userId == request.auth.uid && incoming().status == 'pending_admin';
      allow update: if isAdmin() && isValidId(withdrawalId) && isValidWithdrawal(incoming()) &&
        incoming().id == existing().id && incoming().userId == existing().userId;
      allow delete: if isAdmin() && isValidId(withdrawalId);
    }

    match /videoCampaigns/{campaignId} {
      allow get: if isSignedIn() && isValidId(campaignId) && (
        existing().status == 'active' || existing().creatorId == request.auth.uid || isAdmin()
      );
      allow list: if isSignedIn() && (
        existing().status == 'active' || existing().creatorId == request.auth.uid || isAdminEmail()
      );
      allow create: if isSignedIn() && isValidId(campaignId) && isValidVideoCampaign(incoming()) &&
        incoming().creatorId == request.auth.uid &&
        incoming().status == 'pending_admin' &&
        incoming().watchedByUserIds.size() == 0;
      allow update: if isSignedIn() && isValidId(campaignId) && isValidVideoCampaign(incoming()) &&
        incoming().id == existing().id && incoming().creatorId == existing().creatorId && (
          isAdmin() ||
          (existing().status == 'active' &&
           !(request.auth.uid in existing().watchedByUserIds) &&
           request.auth.uid in incoming().watchedByUserIds &&
           incoming().watchedByUserIds.size() == existing().watchedByUserIds.size() + 1 &&
           incoming().status in ['active', 'completed'] &&
           incoming().diff(existing()).affectedKeys().hasOnly(['watchedByUserIds', 'status', 'updatedAt']))
        );
      allow delete: if isAdmin() && isValidId(campaignId);
    }

    match /customTasks/{taskId} {
      allow get: if isSignedIn() && isValidId(taskId) && (
        existing().status == 'active' || existing().creatorId == request.auth.uid || isAdmin()
      );
      allow list: if isSignedIn() && (
        existing().status == 'active' || existing().creatorId == request.auth.uid || isAdminEmail()
      );
      allow create: if isSignedIn() && isValidId(taskId) && isValidCustomTask(incoming()) &&
        incoming().creatorId == request.auth.uid &&
        incoming().status == 'pending_admin' &&
        incoming().approvedWorkerIds.size() == 0;
      allow update: if isAdmin() && isValidId(taskId) && isValidCustomTask(incoming()) &&
        incoming().id == existing().id && incoming().creatorId == existing().creatorId;
      allow delete: if isAdmin() && isValidId(taskId);
    }

    match /taskSubmissions/{submissionId} {
      allow get: if isSignedIn() && isValidId(submissionId) && (existing().workerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().workerId == request.auth.uid || isAdminEmail());
      allow create: if isSignedIn() && isValidId(submissionId) && isValidTaskSubmission(incoming()) &&
        incoming().workerId == request.auth.uid &&
        incoming().status == 'pending_admin' &&
        exists(/databases/$(database)/documents/customTasks/$(incoming().taskId));
      allow update: if isAdmin() && isValidId(submissionId) && isValidTaskSubmission(incoming()) &&
        incoming().id == existing().id && incoming().workerId == existing().workerId;
      allow delete: if isAdmin() && isValidId(submissionId);
    }

    match /transactions/{txId} {
      allow get: if isSignedIn() && isValidId(txId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isAdminEmail());
      allow create: if isSignedIn() && isValidId(txId) && isValidTransaction(incoming()) && (
        isAdmin() || incoming().userId == request.auth.uid
      );
      allow update: if isAdmin() && isValidId(txId) && isValidTransaction(incoming()) &&
        incoming().id == existing().id && incoming().userId == existing().userId;
      allow delete: if isAdmin() && isValidId(txId);
    }
  }
}
