# POSTGRES_URL / DATABASE_URL: Automatically injected by Vercel when you connect a Postgres store
# (Neon, Supabase, or Prisma Postgres) from Vercel Dashboard -> Storage -> Create Database.
# Schema, indexes, migrations, and default settings initialize automatically on first request.
POSTGRES_URL=
DATABASE_URL=

# ADMIN_EMAIL & ADMIN_PASSCODE: Optional server-side Admin credentials.
# If ADMIN_PASSCODE is omitted, you can set the administrator password securely once from the login dialog.
ADMIN_EMAIL=ezeprodeveloper@gmail.com
ADMIN_PASSCODE=

# APP_URL: Public deployment URL.
APP_URL="MY_APP_URL"
