# FIREBASE_SERVICE_ACCOUNT: Full JSON service account credentials for Firebase Admin SDK
# on Vercel serverless endpoints (/api/*). NEVER expose this to VITE_* or client code.
FIREBASE_SERVICE_ACCOUNT=

# ADMIN_EMAIL: Primary verified administrator email address.
ADMIN_EMAIL=ezeprodeveloper@gmail.com

# APP_URL: Public deployment URL (e.g., https://your-app.vercel.app).
APP_URL="MY_APP_URL"

# VITE_PUBLIC_APP_URL: Optional production origin used for Firebase password reset action links.
# Defaults automatically to window.location.origin in the browser.
VITE_PUBLIC_APP_URL=
