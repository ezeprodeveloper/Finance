# DATABASE_URL: PostgreSQL connection string (Neon, Supabase, or Netlify DB) for Netlify & production hosting.
# When omitted in local development, the server automatically uses SQLite in .data/efinance.sqlite.
DATABASE_URL=

# ADMIN_EMAIL & ADMIN_PASSCODE: Admin sign-in credentials verified strictly on the server.
# If ADMIN_PASSCODE is left unset before first launch, the Admin can set it once from the login dialog.
ADMIN_EMAIL=ezeprodeveloper@gmail.com
ADMIN_PASSCODE=

# APP_URL: The public URL where this application is hosted.
APP_URL="MY_APP_URL"
